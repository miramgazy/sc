        128
      ],
      "id": "4dd14b9f-5a62-4bfa-b2e1-b33634e8e670",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "// Проходим по каждому входящему элементу (обычно он один)\nfor (const item of items) {\n    const body = item.json.body;\n\n    // 1. Получаем строку init_data\n    const initData = body.init_data;\n\n    // 2. Ищем и извлекаем часть \"user=...\"\n    const userMatch = initData.match(/user=(.*?)&/);\n\n    if (userMatch && userMatch[1]) {\n        const userJsonEncoded = userMatch[1];\n        const userJsonDecoded = decodeURIComponent(userJsonEncoded);\n\n        try {\n            const userObject = JSON.parse(userJsonDecoded);\n\n            // Добавляем данные о пользователе\n            item.json.sender_telegram_id = userObject.id;\n            item.json.sender_username = userObject.username;\n            item.json.sender_first_name = userObject.first_name;\n\n        } catch (e) {\n            console.error('Ошибка парсинга JSON объекта пользователя:', e);\n            item.json.error = 'Failed to parse user data from init_data';\n        }\n    } else {\n        console.warn('User data not found in init_data');\n        item.json.sender_telegram_id = null;\n    }\n\n    // --- Проверка текста из scan_result ---\n    const scanResult = body.scan_result?.trim();\n\n    if (scanResult) {\n        // Регулярки\n        const trackRegex = /^[A-Z]{2}\\d{9}[A-Z]{2}$/i; // трек: 2 буквы + 9 цифр + 2 буквы\n        const orderRegex = /^\\d+-\\d+$/;                // внутренний ID: цифры-цифры\n\n        if (trackRegex.test(scanResult)) {\n            item.json.scan_result_type = \"tracking_number\";\n        } else if (orderRegex.test(scanResult)) {\n            item.json.scan_result_type = \"order_id\";\n        } else {\n            item.json.scan_result_type = \"unknown\";\n        }\n\n        // Сохраняем сам текст для удобства\n        item.json.scan_result_value = scanResult;\n    } else {\n        item.json.scan_result_type = \"empty\";\n        item.json.scan_result_value = null;\n    }\n}\n\n// Возвращаем модифицированные элементы\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
