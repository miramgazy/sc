      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"text\":\"Сіз іздеген тапсырыс табылды; id:  {{ $json.order_id }}\\nКлиенттің есімі - {{ $json.customer_name }}\\nТелефоны: +{{ $json.customer_phone }}\\nТапсырыс тізімі: {{ $json.order_items }}\\nОсы тапсырыстың Track номерін сканерлеп жіберіңіз\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
